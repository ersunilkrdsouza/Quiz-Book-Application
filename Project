# Quiz-Book-Application
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Driems Quiz Book App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f2f2f2;
            font-family: Arial, sans-serif;
        }
        .front-page-container {
            max-width: 800px;
            margin: 40px auto;
            padding: 20px;
            background-color: #fff;
            border: 1px solid #ddd;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }
        .front-page-header {
            font-size: 48px;
            font-weight: bold;
            text-align: center;
            margin-bottom: 20px;
        }
        .front-page-subheader {
            font-size: 24px;
            font-weight: bold;
            text-align: center;
            margin-bottom: 20px;
        }
        .front-page-button {
            background-color: #4CAF50;
            color: #fff;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            width: 100%;
        }
        .front-page-button:hover {
            background-color: #3e8e41;
        }
        .quiz-container {
            max-width: 800px;
            margin: 40px auto;
            padding: 20px;
            background-color: #fff;
            border: 1px solid #ddd;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            display: none;
        }
        .question {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 20px;
        }
        .options {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .options li {
            margin-bottom: 10px;
        }
        .options li input[type="radio"] {
            margin-right: 10px;
        }
        .submit-btn {
            background-color: #4CAF50;
            color: #fff;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        .submit-btn:hover {
            background-color: #3e8e41;
        }
        .result {
            font-size: 24px;
            font-weight: bold;
            color: #666;
        }
        .subject-select {
            width: 100%;
            padding: 10px;
            margin-bottom: 20px;
        }
        .class-select {
            width: 100%;
            padding: 10px;
            margin-bottom: 20px;
        }
        .score-container {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <div class="front-page-container">
        <h1 class="front-page-header">Driems Quiz Book App</h1>
        <h2 class="front-page-subheader">Start your quiz journey today!</h2>
        <button class="front-page-button" id="start-quiz-button">Start Quiz</button>
    </div>
    <div class="quiz-container" id="quiz-container">
        <h2>Quiz Book App</h2>
        <select id="class-select" class="class-select">
            <option value="">Select Class</option>
            <option value="1">Class 1</option>
            <option value="2">Class 2</option>
            <option value="3">Class 3</option>
            <option value="4">Class 4</option>
            <option value="5">Class 5</option>
        </select>
        <select id="subject-select" class="subject-select" disabled>
            <option value="">Select Subject</option>
            <option value="math">Math</option>
            <option value="english">English</option>
        </select>
        <div id="question-container" style="display: none;">
            <p class="question" id="question"></p>
            <ul class="options" id="options"></ul>
            <button class="submit-btn" id="submit-btn">Submit</button>
            <div class="score-container" id="score-container">Score: 0</div>
        </div>
        <div id="result-container" style="display: none;">
            <p class="result" id="result"></p>
        </div>
    </div>
    <div class="modal fade" id="quiz-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Quiz Result</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p id="modal-result"></p>
                    <p id="modal-score"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let questions = {
            "1": {
                "math": [
                    {
                        question: "What is 1 + 1?",
                        options: ["1", "2", "3", "4"],
                        answer: 1
                    },
                    {
                        question: "What is 2 + 2?",
                        options: ["3", "4", "5", "6"],
                        answer: 1
                    },
                    {
                        question: "What is 3 + 3?",
                        options: ["5", "6", "7", "8"],
                        answer: 1
                    }
                ],
                "english": [
                    {
                        question: "What is the first letter of the alphabet?",
                        options: ["A", "B", "C", "D"],
                        answer: 0
                    },
                    {
                        question: "What is the capital letter of 'cat'?",
                        options: ["cat", "Cat", "CAt", "CAT"],
                        answer: 1
                    },
                    {
                        question: "What is the small letter of 'DOG'?",
                        options: ["DOG", "DoG", "dOG", "dog"],
                        answer: 3
                    }
                ]
            },
            "2": {
                "math": [
                    {
                        question: "What is 2 + 2?",
                        options: ["3", "4", "5", "6"],
                        answer: 1
                    },
                    {
                        question: "What is 4 + 4?",
                        options: ["6", "7", "8", "10"],
                        answer: 2
                    },
                    {
                        question: "What is 6 + 6?",
                        options: ["10", "11", "12", "14"],
                        answer: 2
                    }
                ],
                "english": [
                    {
                        question: "What is the plural form of 'cat'?",
                        options: ["cat", "cats", "catt", "catty"],
                        answer: 1
                    },
                    {
                        question: "What is the singular form of 'dogs'?",
                        options: ["dog", "dogs", "doggy", "doge"],
                        answer: 0
                    },
                    {
                        question: "What is the meaning of 'run'?",
                        options: ["to jump", "to walk", "to read", "to move quickly"],
                        answer: 3
                    }
                ]
            },
            "3": {
                "math": [
                    {
                        question: "What is 3 + 3?",
                        options: ["5", "6", "7", "8"],
                        answer: 1
                    },
                    {
                        question: "What is 6 + 6?",
                        options: ["10", "11", "12", "14"],
                        answer: 2
                    },
                    {
                        question: "What is 9 + 9?",
                        options: ["15", "16", "17", "18"],
                        answer: 3
                    }
                ],
                "english": [
                    {
                        question: "What is the meaning of 'big'?",
                        options: ["small", "large", "happy", "angry"],
                        answer: 1
                    },
                    {
                        question: "What is the opposite of 'hot'?",
                        options: ["cold", "warm", "cool", "icy"],
                        answer: 0
                    },
                    {
                        question: "What is the meaning of 'friend'?",
                        options: ["a person you like", "a person you dislike", "a person you know", "a family member"],
                        answer: 0
                    }
                ]
            },
            "4": {
                "math": [
                    {
                        question: "What is 4 + 4?",
                        options: ["6", "7", "8", "10"],
                        answer: 2
                    },
                    {
                        question: "What is 8 + 8?",
                        options: ["14", "15", "16", "18"],
                        answer: 2
                    },
                    {
                        question: "What is 12 + 12?",
                        options: ["20", "21", "22", "24"],
                        answer: 3
                    }
                ],
                "english": [
                    {
                        question: "What is the meaning of 'happy'?",
                        options: ["sad", "angry", "joyful", "scared"],
                        answer: 2
                    },
                    {
                        question: "What is the meaning of 'book'?",
                        options: ["a thing you read", "a thing you write", "a thing you draw", "a thing you play"],
                        answer: 0
                    },
                    {
                        question: "What is the meaning of 'school'?",
                        options: ["a place you learn", "a place you play", "a place you eat", "a place you sleep"],
                        answer: 0
                    }
                ]
            },
            "5": {
                "math": [
                    {
                        question: "What is 5 + 5?",
                        options: ["8", "9", "10", "12"],
                        answer: 2
                    },
                    {
                        question: "What is 10 + 10?",
                        options: ["18", "19", "20", "22"],
                        answer: 2
                    },
                    {
                        question: "What is 15 + 15?",
                        options: ["25", "26", "27", "30"],
                        answer: 3
                    }
                ],
                "english": [
                    {
                        question: "What is the meaning of 'family'?",
                        options: ["a group of friends", "a group of people you live with", "a group of people you work with", "a group of people you play with"],
                        answer: 1
                    },
                    {
                        question: "What is the meaning of 'house'?",
                        options: ["a place you live", "a place you work", "a place you play", "a place you eat"],
                        answer: 0
                    },
                    {
                        question: "What is the meaning of 'garden'?",
                        options: ["a place you grow plants", "a place you grow animals", "a place you play", "a place you eat"],
                        answer: 0
                    }
                ]
            }
        };
        let currentQuestion = 0;
        let score = 0;
        let classValue = "";
        let subject = "";

        function loadQuestion() {
            const questionElement = document.getElementById("question");
            const optionsElement = document.getElementById("options");
            questionElement.textContent = questions[classValue][subject][currentQuestion].question;
            optionsElement.innerHTML = "";
            questions[classValue][subject][currentQuestion].options.forEach((option, index) => {
                const liElement = document.createElement("li");
                const inputElement = document.createElement("input");
                const labelElement = document.createElement("label");
                inputElement.type = "radio";
                inputElement.name = "option";
                inputElement.value = index;
                labelElement.textContent = option;
                liElement.appendChild(inputElement);
                liElement.appendChild(labelElement);
                optionsElement.appendChild(liElement);
            });
        }

        function submitAnswer() {
            const selectedOption = document.querySelector('input[name="option"]:checked');
            if (selectedOption) {
                const answer = parseInt(selectedOption.value);
                if (answer === questions[classValue][subject][currentQuestion].answer) {
                    score++;
                    document.getElementById("score-container").textContent = Score: ${score};
                }
                currentQuestion++;
                if (currentQuestion < questions[classValue][subject].length) {
                    loadQuestion();
                } else {
                    displayResult();
                }
            }
        }

        function displayResult() {
            const resultElement = document.getElementById("result");
            resultElement.textContent = Your score is ${score} out of ${questions[classValue][subject].length};
            document.getElementById("question-container").style.display = "none";
            document.getElementById("result-container").style.display = "block";
            const modalResultElement = document.getElementById("modal-result");
            modalResultElement.textContent = Your score is ${score} out of ${questions[classValue][subject].length};
            const modalScoreElement = document.getElementById("modal-score");
            modalScoreElement.textContent = You answered ${score} questions correctly out of ${questions[classValue][subject].length};
            const quizModal = new bootstrap.Modal(document.getElementById("quiz-modal"), {
                keyboard: false
            });
            quizModal.show();
        }

        document.getElementById("class-select").addEventListener("change", (e) => {
            classValue = e.target.value;
            if (classValue) {
                document.getElementById("subject-select").disabled = false;
            } else {
                document.getElementById("subject-select").disabled = true;
            }
        });

        document.getElementById("subject-select").addEventListener("change", (e) => {
            subject = e.target.value;
            if (subject) {
                currentQuestion = 0;
                score = 0;
                document.getElementById("score-container").textContent = Score: ${score};
                loadQuestion();
                document.getElementById("question-container").style.display = "block";
                document.getElementById("result-container").style.display = "none";
            }
        });

        document.getElementById("submit-btn").addEventListener("click", submitAnswer);

        document.getElementById("start-quiz-button").addEventListener("click", () => {
            document.getElementById("quiz-container").style.display = "block";
            document.querySelector(".front-page-container").style.display = "none";
        });
    </script>
</body>
</html>
